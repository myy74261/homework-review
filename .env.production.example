# Application
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0
FORWARD_HEADERS_STRATEGY=framework
SPRING_APPLICATION_NAME=review-desk
THYMELEAF_CACHE=true
SHOW_DEMO_CREDENTIALS=false
UPLOAD_ROOT=/opt/review-desk/uploads
UPLOAD_MAX_FILE_SIZE=25MB
UPLOAD_MAX_REQUEST_SIZE=220MB
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=30
AI_SETTINGS_SECRET=CHANGE_TO_A_LONG_RANDOM_ENCRYPTION_SECRET
JPA_DDL_AUTO=update
JAVA_OPTS="-Xms256m -Xmx512m"

# PostgreSQL inside Docker Compose
POSTGRES_DB=review_desk
POSTGRES_USER=review_desk
POSTGRES_PASSWORD=CHANGE_TO_A_STRONG_DATABASE_PASSWORD

# Spring Boot database connection
DATABASE_URL=jdbc:postgresql://db:5432/review_desk
DATABASE_USERNAME=review_desk
DATABASE_PASSWORD=CHANGE_TO_A_STRONG_DATABASE_PASSWORD

# Browser session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax

# Initial accounts: change both passwords before first start
DEMO_TEACHER_USERNAME=chen
DEMO_TEACHER_PASSWORD=CHANGE_TO_A_STRONG_TEACHER_PASSWORD
DEMO_TEACHER_NAME=陈老师
DEMO_STUDENT_USERNAME=lin
DEMO_STUDENT_PASSWORD=CHANGE_TO_A_STRONG_STUDENT_PASSWORD
DEMO_STUDENT_NAME=林清和
DEMO_STUDENT_NUMBER=20230116

